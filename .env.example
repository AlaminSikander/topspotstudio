# Absolute production origin, no trailing slash. Used for canonicals, sitemap, OG and schema.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# "production" makes the site indexable. Any other value (staging, preview, development)
# sends noindex headers/meta and disallows all crawling in robots.txt.
NEXT_PUBLIC_SITE_ENV=staging

# Google Tag Manager container (GTM-XXXXXXX). GTM is not loaded when empty.
NEXT_PUBLIC_GTM_ID=

# Show the blog in the main navigation, sitemap and index it.
# Keep "false" until at least three approved articles are published.
NEXT_PUBLIC_BLOG_ENABLED=false

# Set "true" once the Privacy Policy has been reviewed and approved for publication.
NEXT_PUBLIC_PRIVACY_APPROVED=false

# Public business email shown on the Contact page and in ContactPoint schema (leave empty until final).
NEXT_PUBLIC_CONTACT_EMAIL=

# Form delivery over SMTP (server-only). Forms return a clear error instead of fake success when these are missing.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465). Defaults to true on 465 and false (STARTTLS) on other ports.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Recipient of Contact and Free SEO Audit submissions; comma-separate multiple addresses.
CONTACT_INBOX=alamin.6534@gmail.com

# Sender shown on notification emails. Defaults to SMTP_USER. Most providers (including Gmail)
# require this to be the SMTP account itself or a verified alias/domain.
FORM_FROM_EMAIL=Top Spot Studio <forms@example.com>
